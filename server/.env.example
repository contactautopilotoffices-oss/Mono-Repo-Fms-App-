# Environment Variables for Autopilot Server
# Copy this file to .env and fill in values

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Supabase (for server-side DB access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cassandra (token exchange endpoint)
CASSANDRA_API_URL=http://localhost:3001
CASSANDRA_API_KEY=your-cassandra-api-key

# Logging
LOG_LEVEL=info
