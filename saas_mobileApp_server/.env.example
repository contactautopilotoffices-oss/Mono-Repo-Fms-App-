NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Firebase Admin SDK (for FCM v1 push notifications)
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

UPSTASH_REDIS_REST_URL="https://right-cat-102149.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAY8FAAIgcDI1OTUxMWZhM2U3NTA0Y2M4YWUzYzQ0NGYzMTMwMDM2NQ"

# ── AiSensy WhatsApp Business Integration ──────────────────────────────────────
# Get your API key from AiSensy Dashboard → Manage → API Key
AISENSY_API_KEY=

# Label shown in AiSensy analytics as message source
AISENSY_SOURCE="FMS App"

# Set to 'false' to disable all WhatsApp sending (useful in dev/test)
AISENSY_ENABLED=true

# Webhook secret — set this in AiSensy Dashboard → Settings → Webhooks → Secret
# This is used to verify incoming webhook requests are really from AiSensy
AISENSY_WEBHOOK_SECRET=

# ── Legacy Wasender WhatsApp (if still in use) ──────────────────────────────────
WHATSAPP_API_URL=https://wasenderapi.com/api
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=
WHATSAPP_ENABLED=false
