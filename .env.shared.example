# Shared local development env for Expo + Cassandra voice server

# Safe to expose to Expo
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_CASSANDRA_API_URL=http://localhost:8001
EXPO_PUBLIC_CASSANDRA_WS_URL=ws://localhost:8001
EXPO_PUBLIC_VOICE_API_URL=http://localhost:8001

# Python/server-side fallbacks
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
CASSANDRA_HOST=0.0.0.0
CASSANDRA_PORT=8001
RCT_METRO_PORT=8081
